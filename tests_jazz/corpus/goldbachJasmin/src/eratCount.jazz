require "erat.jazz"

/* countPrimes: the set bits of the whole segment, eight wheel bytes a time. */
fn countPrimes (reg ptr Sieve::t sieve, reg u64 numPrimes, reg u64 sieveBytes) -> reg u64 
{
  reg u64 sieveIndex = 0;
  while (sieveIndex < sieveBytes) {
    reg u64 byte;
    byte = sieve.[:u64 sieveIndex];      
    reg u64 count;
    ?{}, count = #POPCNT(byte); 
    numPrimes += count;
    sieveIndex += 8;
  } 
  return numPrimes;
}

/* The bits of a wheel byte whose residue is BELOW r (BELOW[r]) or ABOVE r
   (ABOVE[r]), for r in [0, 30): bit i stands for RESIDUES[i] =
   1 7 11 13 17 19 23 29.  What the two cuts at the ends of a run need. */
u8[30] BELOW = {
  0x00, 0x00,                               // r = 0, 1      : nothing below
  0x01, 0x01, 0x01, 0x01, 0x01, 0x01,       // r = 2 .. 7    : 1
  0x03, 0x03, 0x03, 0x03,                   // r = 8 .. 11   : 1 7
  0x07, 0x07,                               // r = 12, 13    : 1 7 11
  0x0f, 0x0f, 0x0f, 0x0f,                   // r = 14 .. 17  : .. 13
  0x1f, 0x1f,                               // r = 18, 19    : .. 17
  0x3f, 0x3f, 0x3f, 0x3f,                   // r = 20 .. 23  : .. 19
  0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f        // r = 24 .. 29  : .. 23
};

u8[30] ABOVE = {
  0xff,                                     // r = 0         : everything
  0xfe, 0xfe, 0xfe, 0xfe, 0xfe, 0xfe,       // r = 1 .. 6    : 7 ..
  0xfc, 0xfc, 0xfc, 0xfc,                   // r = 7 .. 10   : 11 ..
  0xf8, 0xf8,                               // r = 11, 12    : 13 ..
  0xf0, 0xf0, 0xf0, 0xf0,                   // r = 13 .. 16  : 17 ..
  0xe0, 0xe0,                               // r = 17, 18    : 19 ..
  0xc0, 0xc0, 0xc0, 0xc0,                   // r = 19 .. 22  : 23 ..
  0x80, 0x80, 0x80, 0x80, 0x80, 0x80,       // r = 23 .. 28  : 29
  0x00                                      // r = 29        : nothing above
};

/* countBelow: the set bits of the segment standing for a number BELOW
   low + delta, 0 <= delta < SieveSpan.  Byte by byte: it runs once per run. */
fn countBelow (reg ptr Sieve::t sieve, reg u64 delta) -> reg u64
{
  reg ptr u8[30] below = BELOW;
  reg u64 b, r;
  b, r = udiveucl_64_imm(delta, 30);        // delta = 30 * b + r
  reg u64 count = 0;
  reg u64 i = 0;
  while (i < b) {
    reg u64 byte = (64u) sieve[i];
    reg u64 c;
    ?{}, c = #POPCNT(byte);
    count += c;
    i += 1;
  }
  reg u64 byte = (64u) sieve[b];
  reg u64 mask = (64u) below[r];
  byte &= mask;
  reg u64 c;
  ?{}, c = #POPCNT(byte);
  count += c;
  return count;
}

/* countAbove: the set bits of the segment standing for a number ABOVE
   low + delta, 0 <= delta < SieveSpan. */
fn countAbove (reg ptr Sieve::t sieve, reg u64 delta, reg u64 sieveBytes) -> reg u64
{
  reg ptr u8[30] above = ABOVE;
  reg u64 b, r;
  b, r = udiveucl_64_imm(delta, 30);        // delta = 30 * b + r
  reg u64 count = 0;
  reg u64 byte = (64u) sieve[b];
  reg u64 mask = (64u) above[r];
  byte &= mask;
  reg u64 c;
  ?{}, c = #POPCNT(byte);
  count += c;
  reg u64 i = b; i += 1;
  while (i < sieveBytes) {
    byte = (64u) sieve[i];
    ?{}, c = #POPCNT(byte);
    count += c;
    i += 1;
  }
  return count;
}

/* eratCount: the number of primes p of the CLOSED range [lo, hi].
   Pre: lo <= hi, and pool is a block of poolBuckets >= 3 buckets
   (poolBuckets * Bucket::bucketBytes bytes).  When the block is too small
   for the run, eratInit says so and eratCount returns 2^64 - 1, a value no
   count reaches, without sieving; the need and the capacity, in words, are
   then in words 1 and 2 of the block's last bucket (memory.jazz;
   MemoryPoolBuckets is the default, enough for every run).

   The sieve works by whole segments of SieveSpan integers: the run covers the
   segments from the one holding lo to the one holding hi, every segment is
   counted whole, and the two at the ends give back what falls outside
   [lo, hi].  Every lo <= hi < 2^64 is admitted: the last segment may be
   partial (Cfg::init), its positions from 2^64 on lie above hi and are
   given back with the rest.  The wheel has no bit for 2, 3 and 5: they are counted by hand. */
export fn eratCount(reg ptr Sieve::t sieve, 
                    reg Bucket::bucketPtr pool, 
                    reg u64 lo, 
                    reg u64 hi,
                    reg u64 log2SieveBytes,
                    reg u64 poolBuckets) -> 
       reg ptr Sieve::t, reg u64 
{
  stack EratSmall::SmallMem::t smallMem;     
  stack EratMedium::MediumMem::t mediumMem; 
  stack EratBig::BigMem::t bigMem;
  reg Primes::primePtr primes, primesEnd;
  stack u64 lo_s = lo;
  stack u64 hi_s = hi;
  stack Cfg::t cfg;
  #spill(sieve, pool, lo, hi, poolBuckets);
  cfg = Cfg::init(cfg, log2SieveBytes, hi);
  #unspill(sieve, pool, lo, hi, poolBuckets);
  cfg[Cfg::POOLBUCKETS] = poolBuckets;
  /* the pool's budget (poolRoom, erat.jazz): 0 when the chains' fixed part
     alone does not fit, and then no run */
  reg u64 room0;
  _, _, room0 = poolRoom(cfg);
  reg u64 numPrimes;
  if (room0 == 0) {
    numPrimes = -1;                         // the pool is too small: no run
  } else {
  reg u64 k = cfg[Cfg::LOG2];

  /* the run, in segments: [segmentLow, segmentLow + numSegments) */
  reg u64 segmentLow = Cfg::divSpan(lo, k);
  reg u64 numSegments = Cfg::divSpan(hi, k);
  numSegments -= segmentLow;
  numSegments += 1;
  stack u64 numSegments_s = numSegments;
  
  #spill(segmentLow);
  reg u64 ok;
  smallMem, mediumMem, bigMem, sieve, pool, primes, primesEnd, ok
    = eratInit(smallMem, mediumMem, bigMem, sieve, pool, segmentLow, cfg);
  if (ok == 0) {
    numPrimes = -1;                         // the pool is too small: no run
  } else {
  stack Primes::primePtr primesEnd_s = primesEnd;
  #unspill(segmentLow);
  segmentLow *= cfg[Cfg::SPAN];
  // Re-Init smallMem 
  #spill(sieve, pool, primes);
  smallMem = EratSmall::reInit(smallMem, segmentLow);
  #unspill(sieve,  pool, primes);

  /* 2, 3 and 5, which the wheel has no bit for */
  numPrimes = 0;
  reg u64 lo_r = lo_s;
  reg u64 hi_r = hi_s;
  if (lo_r <= 2) { if (hi_r >= 2) { numPrimes += 1; } }
  if (lo_r <= 3) { if (hi_r >= 3) { numPrimes += 1; } }
  if (lo_r <= 5) { if (hi_r >= 5) { numPrimes += 1; } }
 
  while(numSegments_s > 0) {
    #spill(numPrimes);
    smallMem, mediumMem, bigMem, sieve, pool, primes, segmentLow = 
      eratSegment(smallMem, mediumMem, bigMem, sieve, pool, primes, primesEnd_s, segmentLow, cfg); 
    #unspill(numPrimes);
    reg u64 sieveBytes = cfg[Cfg::BYTES];
    numPrimes = countPrimes(sieve, numPrimes, sieveBytes);
    /* eratSegment has moved segmentLow one span up: the segment just sieved
       is [segmentLow - SieveSpan, segmentLow) */
    #spill(sieve, pool, primes, segmentLow);
    reg u64 low, delta, c;
    low = segmentLow; low -= cfg[Cfg::SPAN];
    lo_r = lo_s;
    #[unlikely]
    if (low < lo_r) {                       // the first segment: drop what is below lo
      delta = lo_r; delta -= low;
      c = countBelow(sieve, delta);
      numPrimes -= c;
    }
    #unspill(segmentLow);
    /* The last segment, known by its rank: its end segmentLow wraps when it
       is the partial one holding 2^64 - 1, so no test on that end.  Its low
       segmentLow - SieveSpan, computed in u64, is right even then: the true
       low is below 2^64 and the subtraction is modulo 2^64. */
    #[unlikely]
    if (numSegments_s == 1) {               // the last segment: drop what is above hi
      hi_r = hi_s;
      low = segmentLow; low -= cfg[Cfg::SPAN];
      delta = hi_r; delta -= low;
      sieveBytes = cfg[Cfg::BYTES];
      c = countAbove(sieve, delta, sieveBytes);
      numPrimes -= c;
    }
    #unspill(sieve, pool, primes, segmentLow);
    numSegments_s -= 1;
  }
  }
  }
   
  return sieve, numPrimes;      
}
