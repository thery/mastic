require "erat.jazz"

/* The sieve's internal API: a run initialised once, then one segment per call,
   the client reading the sieved bytes between calls (ec/TODO, item 2).

   eratCount and goldbach drive the sieve themselves: eratInit, then eratSegment
   in a loop, with the three memories of the sieving primes on their own stack.
   An export's stack dies with the call, so a run that spans several calls
   needs its state in the client's memory: the three memories, the
   configuration and a few scalars, all of a size the client reads from
   eratStateSizes.

   The internal functions take the memories as `reg ptr' arrays, so that the
   exports hand them the client's buffers directly (eratCount and goldbach
   hand them their own stack arrays); inside, each pointer waits on the stack
   across the calls that do not use it (erat.jazz).

   The state word st (EratApi::t) holds:
     [CFG .. CFG+16)  Cfg::t, filled by eratInitState
     LOG2, POOLBUCKETS, LO, HI   the client's inputs, read by eratInitState
     POOL               the pool as the sieve left it: MemoryPool::init aligns the
                        client's block on a bucket and the pointer then moves with
                        the allocations, so it is state, like the queue below
     PRIMES, PRIMESEND  the queue of sieving primes in the pool (pointers)
     SEGMENTLOW         the first integer of the NEXT segment to sieve
     NUMSEGMENTS        the segments left in [lo, hi]
     OK                 1 after a successful init, 0 when the pool is too small
   After eratNextSegment the sieve holds the bytes of the segment
   [SEGMENTLOW - SieveSpan, SEGMENTLOW), where SEGMENTLOW is the updated value.
   The first segment is the one holding lo, the last the one holding hi; what
   falls outside [lo, hi] in those two is the client's to drop, as eratCount
   does with countBelow and countAbove. */

namespace EratApi {
  param int CFG         = 0;    // Cfg::t, Cfg::SIZE words
  param int LOG2        = 16;   // in: k, segments of 2^k bytes
  param int POOLBUCKETS = 17;   // in: M, the pool's size in buckets (>= 3)
  param int LO          = 18;   // in
  param int HI          = 19;   // in
  param int PRIMES      = 20;
  param int PRIMESEND   = 21;
  param int SEGMENTLOW  = 22;
  param int NUMSEGMENTS = 23;
  param int OK          = 24;
  param int POOL        = 25;
  param int SIZE        = 32;
  type t = u64[SIZE];

  /* the configuration lives in the state word: copied in and out of a stack Cfg */
  inline fn loadCfg(reg ptr Cfg::t cfg, reg ptr t st) -> reg ptr Cfg::t
  {
    inline int i;
    for i = 0 to Cfg::SIZE { reg u64 w = st[CFG + i]; cfg[i] = w; }
    return cfg;
  }

  inline fn storeCfg(reg ptr t st, reg ptr Cfg::t cfg) -> reg ptr t
  {
    inline int i;
    for i = 0 to Cfg::SIZE { reg u64 w = cfg[i]; st[CFG + i] = w; }
    return st;
  }
}

/* The sizes, in bytes, of the client's four buffers: the state word, then
   the small, medium and big memories, in the order of the exports' arguments. */
export fn eratStateSizes(reg ptr u64[4] p) -> reg ptr u64[4]
{
  p[0] = EratApi::SIZE * 8;
  p[1] = EratSmall::SmallMem::MEM_SIZE * 4;
  p[2] = EratMedium::MediumMem::MediumMemSize * 8;
  p[3] = EratBig::BigMemSizeMax * 8;
  return p;
}

/* Initialise a run: reads k, M, lo, hi from st, fills cfg, the three
   memories and the queue of sieving primes in the pool, and leaves the run
   ready for the segment holding lo.  st[OK] = 0 when the pool is too small
   (eratInit's check; its need and capacity are in the pool's status bucket
   as for eratCount), and then nothing else is initialised. */
export fn eratInitState(reg ptr EratApi::t st,
                        reg ptr EratSmall::SmallMem::t small,
                        reg ptr EratMedium::MediumMem::t medium,
                        reg ptr EratBig::BigMem::t big,
                        reg ptr Sieve::t sieve,
                        reg Bucket::bucketPtr pool)
    -> reg ptr EratApi::t, reg ptr EratSmall::SmallMem::t,
       reg ptr EratMedium::MediumMem::t, reg ptr EratBig::BigMem::t, reg ptr Sieve::t
{
  stack Cfg::t cfg;
  stack u64 primes_s, primesEnd_s, segmentLow_s, numSegments_s, ok_s, pool_s;
  primes_s = 0; primesEnd_s = 0; segmentLow_s = 0; numSegments_s = 0; ok_s = 0; pool_s = 0;

  #spill(st, small, medium, big, sieve, pool);
  reg u64 k = st[EratApi::LOG2];
  reg u64 hi = st[EratApi::HI];
  stack u64 lo_s = st[EratApi::LO];
  stack u64 hi_s = hi;
  cfg = Cfg::init(cfg, k, hi);
  #unspill(st);
  reg u64 poolBuckets = st[EratApi::POOLBUCKETS];
  cfg[Cfg::POOLBUCKETS] = poolBuckets;
  reg u64 room0;
  _, _, room0 = poolRoom(cfg);
  if (room0 != 0) {
    k = cfg[Cfg::LOG2];
    reg u64 lo = lo_s;
    hi = hi_s;
    reg u64 segmentLow = Cfg::divSpan(lo, k);
    reg u64 numSegments = Cfg::divSpan(hi, k);
    numSegments -= segmentLow;
    numSegments += 1;
    numSegments_s = numSegments;
    stack u64 segment0_s = segmentLow;
    reg Primes::primePtr primes, primesEnd;
    reg u64 ok;
    #unspill(small, medium, big, sieve, pool);
    small, medium, big, sieve, pool, primes, primesEnd, ok
      = eratInit(small, medium, big, sieve, pool, segmentLow, cfg);
    #spill(small, medium, big, sieve);
    pool_s = pool;
    ok_s = ok;
    if (ok != 0) {
      primes_s = primes;
      primesEnd_s = primesEnd;
      segmentLow = segment0_s;
      segmentLow *= cfg[Cfg::SPAN];
      segmentLow_s = segmentLow;
      #unspill(small);
      small = EratSmall::reInit(small, segmentLow);
      #spill(small);
    }
  }
  #unspill(st);
  st = EratApi::storeCfg(st, cfg);
  reg u64 t;
  t = primes_s;      st[EratApi::PRIMES] = t;
  t = primesEnd_s;   st[EratApi::PRIMESEND] = t;
  t = segmentLow_s;  st[EratApi::SEGMENTLOW] = t;
  t = numSegments_s; st[EratApi::NUMSEGMENTS] = t;
  t = ok_s;          st[EratApi::OK] = t;
  t = pool_s;        st[EratApi::POOL] = t;
  #unspill(small, medium, big, sieve);
  return st, small, medium, big, sieve;
}

/* Sieve the next segment: on return the sieve holds the bytes of
   [st[SEGMENTLOW] - SieveSpan, st[SEGMENTLOW]) with the updated SEGMENTLOW,
   and NUMSEGMENTS is one less.  The pool is the one of st[POOL]: the client
   passes its block to eratInitState only.  To be called after a successful
   eratInitState; the client stops when NUMSEGMENTS reaches 0 (further calls
   sieve further segments). */
export fn eratNextSegment(reg ptr EratApi::t st,
                          reg ptr EratSmall::SmallMem::t small,
                          reg ptr EratMedium::MediumMem::t medium,
                          reg ptr EratBig::BigMem::t big,
                          reg ptr Sieve::t sieve)
    -> reg ptr EratApi::t, reg ptr EratSmall::SmallMem::t,
       reg ptr EratMedium::MediumMem::t, reg ptr EratBig::BigMem::t, reg ptr Sieve::t
{
  stack Cfg::t cfg;

  #spill(st, small, medium, big, sieve);
  cfg = EratApi::loadCfg(cfg, st);
  reg Bucket::bucketPtr pool = st[EratApi::POOL];
  reg Primes::primePtr primes = st[EratApi::PRIMES];
  stack Primes::primePtr primesEnd_s = st[EratApi::PRIMESEND];
  reg u64 segmentLow = st[EratApi::SEGMENTLOW];
  #unspill(small, medium, big, sieve);
  small, medium, big, sieve, pool, primes, segmentLow =
    eratSegment(small, medium, big, sieve, pool, primes, primesEnd_s, segmentLow, cfg);
  #spill(small, medium, big, sieve, pool, primes, segmentLow);
  #unspill(st, pool, primes, segmentLow);
  st[EratApi::POOL] = pool;
  st[EratApi::PRIMES] = primes;
  st[EratApi::SEGMENTLOW] = segmentLow;
  reg u64 n = st[EratApi::NUMSEGMENTS];
  n -= 1;
  st[EratApi::NUMSEGMENTS] = n;
  #unspill(small, medium, big, sieve);
  return st, small, medium, big, sieve;
}
