require "math.jazz"
require "sieve.jazz"
require "wheel30.jazz"
require "presieve.jazz"
require "crossoffw.jazz"

namespace EratSmall {

/* ------------------------------------------------------------------------------
EraSmall performs the sieve for the small prime numbers between 167 and 6553,
smaller primes (before 167) are marked using "presieve".

total : 809 primes in [167, 6553]

We keep 64 list of size 128 for each class and 8 extra list,
all of them are stored in smalls_mem.

We keep also an array of position of the last element of the list, the begin can be obtained 
by keeping the end modulo 128.

------------------------------------------------------------------------------ */

/* struct
   u8 sievingPrime;    /* p / 30 */
   u24 multipleIndex;  /* byte offset of next multiple, RELATIVE to segment */
*/

namespace SmallSievingPrime {

  type t = u32;

  inline fn sievePrime(reg t sievingPrime) -> reg u64 { 
    reg u32 tmp = sievingPrime;
    reg u64 sievePrime;
    ?{}, sievePrime = (64u)#SHR_32(tmp, 24);
    return sievePrime;
  } 

  inline fn multipleIndex(reg t sievingPrime) -> reg u64 {
    reg u32 tmp = sievingPrime;
    reg u64 multipleIndex;
    ?{}, multipleIndex = (64u)#AND_32(tmp, (1 << 24) -1);
    return multipleIndex;
  } 
  
  inline fn decompose(reg t sievingPrime) -> 
     reg u64, reg u64 { 
     reg u64 sievePrime, multipleIndex;
     sievePrime = sievePrime(sievingPrime);
     multipleIndex = multipleIndex(sievingPrime);
     return sievePrime, multipleIndex;
  }

  inline fn sievingPrime (reg u64 sievePrime, reg u64 multipleIndex) -> reg t {
    reg t sievingPrime = sievePrime;
    sievingPrime <<= 24;
    sievingPrime |= multipleIndex; 
    return sievingPrime;
  }

} // SmallSievingPrime

namespace SmallMem {
  /* 
     struct {
       u32[128 * (64 + 8)] primes;
       u32[64] ends;
       u32[8] extra;
     }
  */

  param int PRIMES_SIZE = 128 * (64 + 8);
  param int MEM_SIZE = PRIMES_SIZE + 64 + 8;
  type t = u32[MEM_SIZE];
  
  fn init(reg ptr t mem) -> reg ptr t 
  {   
    // Init the small memory 
    reg u64 i = 0;
    while (i < 64 + 8) {
      reg u64 start = i; start <<= 7; // start = i * 128; 
      mem[PRIMES_SIZE + i] = start;
      i += 1;
    }
    return mem;
  }   

  inline fn getEnd(reg ptr t mem, reg u64 wheelIndex) -> reg u64 
  { 
    reg u64 end = (64u)mem[PRIMES_SIZE + wheelIndex];
    return end;
  }

  inline fn getStart(reg u64 end) -> reg u64 
  {
    reg u64 start;
    start = end; start &= -128; // start = end - (end % 128);
    return start;
  }

  /* Returns the position of the first element and 
     the position following the last elememt of a wheelIndex class */
  inline fn getPrimes(reg ptr t mem, reg u64 wheelIndex) -> reg u64, reg u64 
  {
    reg u64 start, end;
    end = getEnd(mem, wheelIndex);
    start = getStart(end);
    return start, end;
  } 

  inline fn sievingPrime(reg ptr t mem, reg u64 pos) -> reg u64, reg u64
  {
    reg SmallSievingPrime::t sievingPrime;
    reg u64 sievePrime, multipleIndex;
    sievingPrime = mem[:u32 pos];
    sievePrime, multipleIndex = SmallSievingPrime::decompose(sievingPrime);
    return sievePrime, multipleIndex; 
  } 

  inline fn storeSievingPrime (reg ptr t mem, reg u64 sievePrime, reg u64 multipleIndex, reg u64 wheelIndex) -> 
    reg ptr t 
  {
    reg u64 end = (64u)mem[PRIMES_SIZE + wheelIndex];
    reg SmallSievingPrime::t sievingPrime;
    sievingPrime = SmallSievingPrime::sievingPrime(sievePrime, multipleIndex);
    mem[end] = sievingPrime;
    end += 1;
    mem[PRIMES_SIZE + wheelIndex] = end;
    return mem;
  }
  
  inline fn getExtra(reg ptr t mem, inline int i) -> reg u64, reg u64 
  {
    reg u64 extra_end, extra_start;
    extra_end = (64u)mem[PRIMES_SIZE + 64 + i]; 
    extra_start = getStart(extra_end);
    return extra_start, extra_end;
  }       

  inline fn getExtraR(reg ptr t mem, reg u64 i) -> reg u64, reg u64 
  {
    reg u64 extra_end, extra_start;
    extra_end = (64u)mem[PRIMES_SIZE + 64 + i]; 
    extra_start = getStart(extra_end);
    return extra_start, extra_end;
  }       

  // Pre : wheelIndex is a multiple of 8
  inline fn free (reg ptr t mem, reg u64 wheelIndex) -> reg ptr t 
  {
    inline int i;
    for i = 0 to 8 {
      reg u64 end, extra_start;
      end = (64u)mem[PRIMES_SIZE + wheelIndex + i];
      extra_start, _ = getExtra(mem, i); 
      mem[PRIMES_SIZE + wheelIndex + i] = extra_start;
      mem[PRIMES_SIZE + 64 + i] = end;
    } 
    return mem;
  } 

  inline fn nextSegment(reg ptr t mem, reg u64 sieveBytes) -> reg ptr t 
  {
    reg u64 wheelIndex;
    wheelIndex = 0;
    while (wheelIndex < 64) {
      reg u64 start, end;
      start, end = getPrimes(mem, wheelIndex);
      wheelIndex += 1;
      while(start < end) {
        mem[start] -= sieveBytes;
        start += 1;
      }
      
    }      
    return mem;
  }

  fn addSmall(reg ptr Wheel30::RESIDUES_t residues, reg u64 segmentLow, reg ptr t mem, reg u64 sievePrime, reg u64 r) -> reg ptr t 
  {   
    reg u64 rc, multiple, qwheelIndex, wheelIndex, multipleIndex;
    rc = (64u)residues[r];
    multiple, qwheelIndex = Wheel30::firstMultiple(sievePrime, rc, segmentLow);
    multiple -= segmentLow;
    multipleIndex = udiv_64_imm(multiple, 30); 
    wheelIndex = r; wheelIndex <<= 3; wheelIndex += qwheelIndex;
    mem = storeSievingPrime(mem, sievePrime, multipleIndex, wheelIndex);
    return mem;
  }
 
} // SmallMem

require "eratSmall_aux.jazz"

fn eratSmall(reg ptr Sieve::t sieve, reg ptr SmallMem::t mem, reg u64 sieveBytes) -> 
   reg ptr Sieve::t, reg ptr SmallMem::t 
{
  reg u64 endSieve = 0;
  while (endSieve < sieveBytes) {
    endSieve += L1CacheSize;
    sieve, mem = crossOff(sieve, mem, endSieve);
  }
  mem = SmallMem::nextSegment(mem, sieveBytes);
  return sieve, mem;   
}    
    
fn addSmall(reg ptr Wheel30::RESIDUES_t residues, reg u64 segmentLow, reg ptr Sieve::t sieve, reg ptr SmallMem::t mem, reg u64 sievePrime, reg u64 r) -> reg ptr SmallMem::t 
{   
  reg bool is_prime;
  is_prime = Sieve::is_prime(sieve, sievePrime, r);
  if (is_prime) {
    mem = SmallMem::addSmall(residues, segmentLow, mem, sievePrime, r);
  }
  return mem;
}    

fn init(reg ptr Sieve::t sieve, reg ptr SmallMem::t mem, reg u64 sieveBytes) -> reg ptr Sieve::t, reg ptr SmallMem::t 
{
  // Init the small memory 
  mem = SmallMem::init(mem);

  // First use presieve to obtain the list of small prime 
  #spill(mem);
  reg u64 segmentLow = 0;
  sieve = PreSieve::preSieve(sieve, segmentLow, sieveBytes);
  #unspill(mem);
 
 // Fill the small memory with the small prime between 167 and 6553 

  reg ptr Wheel30::RESIDUES_t residues = Wheel30::RESIDUES;
  reg ptr Wheel30::IDX_OF_t idx_of = Wheel30::IDX_OF;
  reg u64 sievePrime = minEratSmall / 30;
  reg u64 r = (64u)idx_of[minEratSmall % 30]; 
   
  while (sievePrime < maxEratSmall / 30) {
    
    while (r < 8) { 
      mem = addSmall(residues, segmentLow, sieve, mem, sievePrime, r);
      r += 1;
    }
    sievePrime += 1;
    r = 0;
  }

  reg u64 last = (64u)idx_of[maxEratSmall % 30];
  while (r <= last) {
    mem = addSmall(residues, segmentLow, sieve, mem, sievePrime, r);
    r += 1;
  }

  return sieve, mem;
}
// Pre: segmentLow is a multiple of 30
fn reInit(reg ptr SmallMem::t mem, reg u64 segmentLow) -> reg ptr SmallMem::t 
{
  reg ptr Wheel30::RESIDUES_t residues = Wheel30::RESIDUES;
  reg u64 wheelIndex = 0;
  while (wheelIndex < 64) {
    mem = SmallMem::free(mem, wheelIndex);

    reg u64 i = 0;
    reg u64 r = wheelIndex; r >>= 3;

    while (i < 8) {
      reg u64 start, end;
      start, end = SmallMem::getExtraR(mem, i);

      while (start < end) { 
        reg u64 sievePrime;
        sievePrime, _ = SmallMem::sievingPrime(mem, start);
        mem = SmallMem::addSmall(residues, segmentLow, mem, sievePrime, r);
        start += 1;
      }
      i += 1;
    }
    wheelIndex += 8;      
  }  
  return mem;
}
} // EratSmall
